# OS metadata.
.DS_Store
._*
Thumbs.db
Desktop.ini

# SDK export staging/backup output.
/.sdk-export-backup~/
/.sdk-export-backup~.meta

# Application-only wire generator input. SDK ships ComponentCodecs.g.cs.
/Scripts/Serialization/Generated/csc.rsp
/Scripts/Serialization/Generated/csc.rsp.meta
/Scripts/Serialization/Generated/*.additionalfile
/Scripts/Serialization/Generated/*.additionalfile.meta
/Assets/Scripts/HSESerialization/Versioned/Generated/WireHistory.HSEWireGenerator.additionalfile
/Assets/Scripts/HSESerialization/Versioned/Generated/WireHistory.HSEWireGenerator.additionalfile.meta

# Hidden repository files do not need Unity metadata.
/.gitignore.meta

# Do NOT ignore *.meta globally: Unity GUID references require them.
# Keep package.json, source, plugins, shaders, materials, prefabs and their .meta files.
